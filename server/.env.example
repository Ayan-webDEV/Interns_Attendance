NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/<database>
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
INVITE_TOKEN_ENCRYPTION_KEY=optional_long_random_secret_for_invite_token_encryption
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
ADMIN_EMAILS=ceo@ve.in,marketing@ve.in
SEED_ADMIN_EMAIL=ceo@ve.in
SEED_ADMIN_NAME=VELoop CEO
SEED_ADMIN_PASSWORD=replace_with_unique_password_12_chars_minimum
SEED_MARKETING_ADMIN_EMAIL=marketing@ve.in
SEED_MARKETING_ADMIN_NAME=VELoop Marketing Admin
SEED_MARKETING_ADMIN_PASSWORD=replace_with_a_different_unique_password
OFFER_GENERATOR_VERIFY_URL=https://veloop-offer-generator.onrender.com/api/interns/verify
OFFER_GENERATOR_API_KEY=replace_with_same_strong_secret_as_offer_generator
ATTENDANCE_MIN_SECONDS=50
INTERN_CASH_TO_INR=0.5
